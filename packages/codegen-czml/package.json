{
  "name": "@cesium-ai/codegen-czml",
  "version": "0.0.1",
  "description": "Intent-to-verified-CZML generation pipeline (model-agnostic generation grounded in an inlined CZML reference, plus semantic verification via Cesium's own CzmlDataSource parser) and the schema-only `generateCzml` tool definition that fronts it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./names": {
      "types": "./dist/tool-names.d.ts",
      "import": "./dist/tool-names.js",
      "default": "./dist/tool-names.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck:test": "tsc -p tsconfig.typecheck.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ai": "^7.0.0",
    "cesium": "^1.127.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0",
    "typescript": "~5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
