# Copy this file to .env and fill in your values.
# The Ion token is baked into the Vite client bundle at build time (VITE_* prefix).
# It is intentionally client-visible — scope it in the Ion console to restrict allowed assets and HTTP referrers.

# Cesium Ion access token — get one free at https://ion.cesium.com
VITE_CESIUM_ION_ACCESS_TOKEN=

# Minimum severity for the codegen sandbox's console logger (debug/info/warn/error/silent).
# Reports sandbox run start/success/failure plus every host-bridge call (get/set/apply/construct/
# async factory) the generated code makes against the live Viewer — useful when a sandboxed run
# reports success but nothing visibly changes. Defaults to "debug" in dev builds, "silent" in
# production builds; uncomment to override either way. See src/utils/config.ts.
# VITE_SANDBOX_LOG_LEVEL=debug
